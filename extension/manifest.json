{
  "manifest_version": 3,
  "name": "GitHub Markdown PR Viewer",
  "description": "PRに表示されているMarkdownの差分を、ツリーと最大化つきモーダルで読むプレビュー。",
  "version": "0.1.0",
  "minimum_chrome_version": "123",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
