{
  "name": "chrome-gh-md-viewer",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e",
    "check:release-age": "node scripts/check-release-age.ts"
  },
  "dependencies": {
    "@primer/octicons": "19.42.0",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
