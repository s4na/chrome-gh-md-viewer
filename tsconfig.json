{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["chrome", "node"]
  },
  "include": [
    "scripts",
    "src",
    "tests",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
